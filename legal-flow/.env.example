# Копия для локальной разработки. Реальные значения — только на сервере,
# никогда не коммитить .env с настоящими секретами.

ENVIRONMENT=development

# --- База данных ---
DATABASE_URL=postgresql+asyncpg://pravovoy_potok:CHANGE_ME@localhost:5432/pravovoy_potok

# --- Redis (сессии-независимый rate limit, очередь фоновых задач) ---
REDIS_URL=redis://localhost:6379/0

# --- Сессии/куки ---
SESSION_COOKIE_NAME=pp_session
CSRF_COOKIE_NAME=pp_csrf
# Секрет для подписи ничего не подписывает (сессии — opaque токены в БД),
# но используется для дополнительного HMAC CSRF-токена.
CSRF_SECRET=CHANGE_ME_LONG_RANDOM_VALUE
COOKIE_SECURE=true
COOKIE_DOMAIN=
# "lax" — по умолчанию, для одного домена/обратного прокси на /api/*.
# "none" — обязательно, если frontend и API на РАЗНЫХ доменах (например, два
# разных поддомена *.onrender.com); тогда COOKIE_SECURE должен быть true.
COOKIE_SAMESITE=lax

# --- CORS (домен статического фронтенда на Netlify) ---
FRONTEND_ORIGIN=https://example-frontend.netlify.app

# --- Trial ---
TRIAL_HOURS=72
TRIAL_PLAN_CODE=start

# --- Единственная модель ИИ: YandexGPT Pro 5.1 ---
# Ни один из перечисленных ниже параметров нельзя тихо заменить на другую модель.
LLM_PROVIDER=yandexgpt_pro_5_1
YANDEX_FOLDER_ID=
YANDEX_MODEL_URI=
YANDEX_API_KEY=
# Явный флаг фикстур для тестов/демо без реального ключа.
LLM_FIXTURE_MODE=true

# --- Платежи (пока не согласован провайдер) ---
PAYMENT_PROVIDER=not_configured
# Значение "fake" допустимо только в тестовом окружении (ENVIRONMENT=test).
PAYMENT_WEBHOOK_SECRET=

# --- Экспорт / Яндекс.Диск (пока не подключён) ---
YANDEX_DISK_ENABLED=false

# --- Прочее ---
LOG_LEVEL=INFO

# Скопируйте в deploy/.env (cp .env.production.example .env), заполните и выставьте права: chmod 600 .env
# Файл .env в git НЕ коммитится и в чат/почту не отправляется.

# Чтобы команды были короткими: «docker compose ...» сам возьмёт нужный файл.
COMPOSE_FILE=docker-compose.prod.yml

# --- Домен ---
DOMAIN=pravpotok.ru
FRONTEND_ORIGIN=https://pravpotok.ru

# --- Секреты (сгенерируйте: openssl rand -hex 32) ---
POSTGRES_PASSWORD=СГЕНЕРИРУЙТЕ_ДЛИННЫЙ_ПАРОЛЬ
CSRF_SECRET=СГЕНЕРИРУЙТЕ_ДЛИННУЮ_СТРОКУ

# --- Куки (сайт и API на одном домене) ---
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- ИИ: YandexGPT + запасная модель при отказе/битом JSON ---
LLM_PROVIDER=yandexgpt_pro_5_1
LLM_FIXTURE_MODE=false
YANDEX_FOLDER_ID=ВАШ_ID_КАТАЛОГА_ЯНДЕКС_ОБЛАКА
YANDEX_MODEL_URI=gpt://ВАШ_ID_КАТАЛОГА_ЯНДЕКС_ОБЛАКА/yandexgpt-5.1
YANDEX_API_KEY=ВАШ_API_КЛЮЧ_ЯНДЕКСА
LLM_FALLBACK_MODEL=deepseek-v4-flash
LLM_MAX_TOKENS=4000

# --- Сбор материалов ---
SOURCE_FIXTURE_MODE=false
LIST_PAGES_PER_SITE=3

# --- Прочее ---
PAYMENT_PROVIDER=not_configured
LOG_LEVEL=INFO
